{
  "name": "free-now",
  "version": "1.0.0",
  "private": true,
  "description": "Hangry — an invite-only PWA so a small circle of friends can say they're free.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:ui": "tsx --test --test-concurrency=1 test/ui/*.spec.ts",
    "vapid": "tsx src/push/vapid.ts",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
