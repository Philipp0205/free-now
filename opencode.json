{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--isolated",
        "--output-dir",
        ".oc/shots",
        "--image-responses",
        "allow"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}
