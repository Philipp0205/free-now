# Copy to .env for local overrides. Everything has a default except the VAPID keys.
PORT=3000
DB_PATH=./data/free-now.sqlite
# Local default. In production set this to the public HTTPS origin once the
# custom domain is chosen, for example https://hangry.example
PUBLIC_BASE_URL=http://localhost:3000

# Generate with: npm run vapid
# Leave unset for local two-browser testing. Notifications then stay inside the app.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# How long a social stays active. Default is 2 hours.
SOCIAL_TTL_MS=7200000

# Calendar timezone used to decide what "tomorrow" means.
# Defaults to Europe/Berlin so a plan made just after midnight there is still tomorrow.
APP_TZ=Europe/Berlin

# Map tab basemap. The default is Esri World Street Map (no API key).
# CARTO Voyager and dark_all currently return an API-key watermark, so they
# are not the default. With a CARTO key, set both of these, for example:
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors © CARTO

# Operator routes. POST /api/admin/query and GET /api/admin/schema stay read-only.
# POST /api/admin/circles/:id/delete
# POST /api/admin/circles/:id/members/:userId/admin  {"admin":true|false}
# Unset, or shorter than 32 characters, those paths stay hidden (404).
# A bad token is also 404. Send it as: Authorization: Bearer <token>
# Do not commit a real token.
# ADMIN_TOKEN=
